{
  "name": "airbnb-cities-etl",
  "description": "One city/snapshot per run: bronze → silver → gold → validation. Run Milan and Florence sequentially before the Week 1 freeze.",
  "max_concurrent_runs": 1,
  "queue": {"enabled": true},
  "timeout_seconds": 3600,
  "tags": {"project": "bigdata_project_cities", "owner": "yaropolk"},
  "git_source": {
    "git_url": "https://github.com/YarkoKalmuk/bigdata_project_cities.git",
    "git_provider": "gitHub",
    "git_commit": "f408ac01ffdd025fab6df220c8f89b24d3d4fda6"
  },
  "parameters": [
    {"name": "catalog", "default": "workspace"},
    {"name": "city", "default": "milan"},
    {"name": "snapshot_date", "default": "2026-09-19"},
    {"name": "source_path", "default": ""},
    {"name": "source_url", "default": ""},
    {"name": "sources_config_path", "default": ""}
  ],
  "tasks": [
    {
      "task_key": "bronze",
      "max_retries": 0,
      "notebook_task": {"notebook_path": "notebooks/01_ingest_bronze.py", "source": "GIT"}
    },
    {
      "task_key": "silver",
      "depends_on": [{"task_key": "bronze"}],
      "max_retries": 0,
      "notebook_task": {"notebook_path": "notebooks/02_prepare_silver.py", "source": "GIT"}
    },
    {
      "task_key": "gold",
      "depends_on": [{"task_key": "silver"}],
      "max_retries": 0,
      "notebook_task": {"notebook_path": "notebooks/03_build_gold.py", "source": "GIT"}
    },
    {
      "task_key": "validate",
      "depends_on": [{"task_key": "gold"}],
      "max_retries": 0,
      "notebook_task": {
        "notebook_path": "notebooks/04_validate_pipeline.py",
        "source": "GIT",
        "base_parameters": {"job_id": "{{job.id}}", "job_run_id": "{{job.run_id}}"}
      }
    }
  ]
}
